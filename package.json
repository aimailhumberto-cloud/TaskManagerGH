    "@types/react-dom": "19.1.11",
    "marked": "^11.1.1",
    "next": "15.5.27",
    "nodemailer": "10.0.15",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.40.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
